//| mvnDeps: ["works.iterative::mill-iw-support::0.1.3", "com.goyeau::mill-scalafix::0.6.0"]
// PURPOSE: Mill build definition for the claude-code-query Scala SDK.
// PURPOSE: Defines four modules: core (shared types/parsing), direct (Ox-based sync API), effectful (cats-effect/fs2 async API), zio (ZIO/ZStream async API).
package build

import mill._, scalalib._, scalajslib._, publish._
import mill.scalajslib.api._
import works.iterative.mill._
import com.goyeau.mill.scalafix.ScalafixModule

// First-party iw-support artifacts live in the iterative-works Forgejo Maven
// registry (Sonatype Central hosts none of them); the org is public, so reads
// are anonymous. Mill resolves each module's dependency graph with that
// module's repositories, so every module that reaches iw-support-time —
// directly or through core.js — mixes this in.
trait IWRegistryModule extends CoursierModule {
  override def repositories = Task {
    super.repositories() ++ Seq("https://code.iterative.works/api/packages/iterative-works/maven")
  }
}

trait SharedModule extends IWScalaModule with PublishModule with ScalafixModule with IWRegistryModule {
  override def scalaVersion = IWScalaVersions.scala3LTSVersion
  // ScalafixModule handles -Xsemanticdb, so disable IWScalaModule's duplicate
  override def semanticDbOptions = Task { Seq.empty }
  def publishVersion = "0.5.0-SNAPSHOT"
  override def artifactName = "claude-code-query-" + super.artifactName()
  def pomSettings = PomSettings(
    description = "Scala SDK for Claude Code CLI",
    organization = "works.iterative",
    url = "https://github.com/iterative-works/claude-code-query",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("iterative-works", "claude-code-query"),
    developers = Seq(Developer("mph", "Michal Příhoda", "https://github.com/mprihoda"))
  )
}

object core extends SharedModule {
  // Platform-free sources (model, parsing) live in shared/src and are also compiled by core.js
  override def sources = Task.Sources("src", "shared/src")
  def mvnDeps = Seq(
    mvn"io.circe::circe-core:0.14.15",
    mvn"io.circe::circe-parser:0.14.15",
    mvn"com.lihaoyi::os-lib:0.11.8",
    mvn"works.iterative.support::iw-support-time:0.2.0"
  )

  // Scala.js build of the shared sources: the message/log model and parsers for browser consumers
  object js extends SharedModule with ScalaJSModule {
    override def scalaJSVersion = "1.20.2"
    override def artifactName = "claude-code-query-core"
    override def sources = Task.Sources(moduleDir / os.up / "shared" / "src")
    def mvnDeps = Seq(
      mvn"io.circe::circe-core::0.14.15",
      mvn"io.circe::circe-parser::0.14.15",
      mvn"works.iterative.support::iw-support-time::0.2.0"
    )
  }

  object test extends ScalaTests with TestModule.Munit {
    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.1.1",
      mvn"org.typelevel::munit-cats-effect:2.1.0",
      mvn"org.scalacheck::scalacheck:1.18.1",
      mvn"org.scalameta::munit-scalacheck:1.1.0",
      mvn"co.fs2::fs2-core:3.13.0"
    )
  }

  object itest extends ScalaTests with TestModule.Munit {
    def moduleDeps = super.moduleDeps ++ Seq(core.test)
    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.1.1",
      mvn"org.typelevel::munit-cats-effect:2.1.0",
      mvn"org.scalacheck::scalacheck:1.18.1",
      mvn"org.scalameta::munit-scalacheck:1.1.0",
      mvn"co.fs2::fs2-core:3.13.0"
    )
  }
}

